# TEMPLATE ONLY: copy this file to .env and put real values in .env. The app never reads .env.example.
# Never commit .env. On Vercel set these under Project Settings > Environment Variables.
# Name shown in the app and landing page
APP_NAME=GroupFlow
SECRET_KEY=change-me-to-a-long-random-string
# Leave DATABASE_URL empty locally to use SQLite. On Vercel paste the Neon connection string.
DATABASE_URL=
# Email through Google Apps Script (optional; email is skipped when these are empty)
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
# Protects the daily reminder endpoint (Vercel Cron sends it automatically)
CRON_SECRET=
